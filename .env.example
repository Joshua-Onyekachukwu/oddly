# ===========================================
# ODDLY — Betting Intelligence Platform
# Environment Variables Template
# ===========================================
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.

# -------------------------------------------
# SUPABASE (Required)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------------------
# NVIDIA NIM API (Required for AI predictions)
# Get free keys from https://build.nvidia.com
# -------------------------------------------
NVIDIA_KEY_1=nvapi-xxxx1
NVIDIA_KEY_2=nvapi-xxxx2
NVIDIA_KEY_3=nvapi-xxxx3
NVIDIA_KEY_4=nvapi-xxxx4
NVIDIA_KEY_5=nvapi-xxxx5
NVIDIA_KEY_6=nvapi-xxxx6
NVIDIA_KEY_7=nvapi-xxxx7
NVIDIA_KEY_8=nvapi-xxxx8
NVIDIA_KEY_9=nvapi-xxxx9
NVIDIA_KEY_10=nvapi-xxxx10

# -------------------------------------------
# DATA SOURCES (Required for live odds/fixtures)
# -------------------------------------------
THE_ODDS_API_KEY=your_the_odds_api_key
API_FOOTBALL_KEY=your_api_football_key

# -------------------------------------------
# STRIPE (Optional — disabled for now)
# Get these from https://dashboard.stripe.com
# -------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_PREMIUM_PRICE_ID=price_xxxxx
# STRIPE_ELITE_PRICE_ID=price_xxxxx

# -------------------------------------------
# APP
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Oddly

# -------------------------------------------
# VERCEL (Set in Vercel Dashboard)
# -------------------------------------------
# VERCEL_CRON_SECRET=auto-generated_by_vercel
