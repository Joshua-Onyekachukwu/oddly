# ===========================================
# ODDLY — Betting Intelligence Platform
# Environment Variables Template
# ===========================================

# -------------------------------------------
# SUPABASE
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------------------
# NVIDIA NIM API (Free keys from build.nvidia.com)
# -------------------------------------------
NVIDIA_KEY_1=nvapi-xxxx1
NVIDIA_KEY_2=nvapi-xxxx2
NVIDIA_KEY_3=nvapi-xxxx3
NVIDIA_KEY_4=nvapi-xxxx4
NVIDIA_KEY_5=nvapi-xxxx5
NVIDIA_KEY_6=nvapi-xxxx6
NVIDIA_KEY_7=nvapi-xxxx7
NVIDIA_KEY_8=nvapi-xxxx8
NVIDIA_KEY_9=nvapi-xxxx9
NVIDIA_KEY_10=nvapi-xxxx10

# -------------------------------------------
# DATA SOURCES
# -------------------------------------------
ODDS_API_KEY=your_the_odds_api_key

# -------------------------------------------
# APP
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Oddly

# -------------------------------------------
# PAYMENT (Future - when subscriptions launch)
# -------------------------------------------
# PAYSTACK_SECRET_KEY=your_paystack_secret_key
# PAYSTACK_PUBLIC_KEY=your_paystack_public_key
# KORAPAY_SECRET_KEY=your_korapay_secret_key

# -------------------------------------------
# EMAIL (Optional - for notifications)
# -------------------------------------------
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=noreply@oddly.gg
